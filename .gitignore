# Anchored to the repository root: an unanchored "server" also matched the
# cmd/server *directory*, which is why cmd/server/main.go was never committed
# and a fresh clone could not build.
/server
data/*.db
data/*.db-*
data/attachments/*
data/backups/*
!data/attachments/.gitkeep
!data/backups/.gitkeep
server-linux
node_modules/

# macOS
.DS_Store

# Derived mockup archive
mockups.zip

# Local tooling scratch
.playwright-cli/

# Private API credentials for local workflow-video production
.env
.env.*
!.env.example

# Python bytecode from the workflow-video tooling
__pycache__/

# Everything under output/ is generated: Go coverage, Playwright runs and
# reports, manual captures, dataset maps, review evidence, server logs and
# the workflow-video library. Nothing there is committed.
output/

# Private operational and security-review material
/docs/deployment/
/security-review/
