# Anchored to the repository root: an unanchored "server" also matched the
# cmd/server *directory*, which is why cmd/server/main.go was never committed
# and a fresh clone could not build.
/server
data/*.db
data/*.db-*
data/attachments/*
data/backups/*
!data/attachments/.gitkeep
!data/backups/.gitkeep
server-linux
node_modules/
output/playwright/runtime/
output/playwright/report/
output/playwright/test-results/
output/coverage.out
output/manual-browser/
# Artifacts of the synthetic dataset run (tests/dataset): the resolved id maps
# and the request-key -> id map each phase writes for the next one to read.
output/dataset/
# Per-shot capture metadata for the user manual. Regenerated by every capture
# run and merged into docs/manual/assets/shots.json, which *is* committed.
output/manual/

# macOS
.DS_Store

# Derived mockup archive
mockups.zip

# Playwright screenshot artifacts. Regenerated by the suite:
#   baseline/ is the frozen pre-redesign record (kept locally, see
#   docs/superpowers/PROGRESS.md); current/ is each run's capture.
#   FERVID_SHOT_DIR=<name> writes a third set, so ignore any capture directory
#   rather than naming them one at a time.
output/playwright/baseline/
output/playwright/current/
output/playwright/*/
output/playwright/*.png

# Local tooling scratch
.playwright-cli/
