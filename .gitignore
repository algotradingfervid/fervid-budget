# Anchored to the repository root: an unanchored "server" also matched the
# cmd/server *directory*, which is why cmd/server/main.go was never committed
# and a fresh clone could not build.
/server
data/*.db
data/*.db-*
data/attachments/*
data/backups/*
!data/attachments/.gitkeep
!data/backups/.gitkeep
server-linux
node_modules/
output/playwright/runtime/
output/playwright/report/
output/playwright/test-results/
output/coverage.out
output/manual-browser/

# macOS
.DS_Store

# Derived mockup archive
mockups.zip

# Playwright screenshot artifacts. Regenerated by the suite:
#   baseline/ is the frozen pre-redesign record (kept locally, see
#   docs/superpowers/PROGRESS.md); current/ is each run's capture.
output/playwright/baseline/
output/playwright/current/
output/playwright/*.png

# Local tooling scratch
.playwright-cli/
