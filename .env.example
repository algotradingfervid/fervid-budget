OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-lite-tts
OPENROUTER_TTS_VOICE=Kore
OPENROUTER_TTS_FORMAT=pcm
VIDEO_NARRATION_LANGUAGE=en-IN

# Server security configuration (production uses HTTPS).
FERVID_ADDR=127.0.0.1:8080
FERVID_SECURE_COOKIES=true
FERVID_ADMIN_PASSWORD=
FERVID_SESSION_KEY=
# Behind Caddy on the same host this must be 127.0.0.1, or every visitor shares
# one login/reset rate-limit bucket.
FERVID_TRUSTED_PROXIES=
# POSTs to /login* per minute, per client address and overall. Keep the
# defaults in production; only test servers raise them.
FERVID_LOGIN_LIMIT_PER_IP=30
FERVID_LOGIN_LIMIT_GLOBAL=300
# Also serve the design-system reference page (/static/_kitchensink.html).
# Only test and development servers turn this on.
FERVID_DEV_PAGES=false
FERVID_SMTP_ALLOWED_HOSTS=
FERVID_ATTACHMENT_QUOTA_MB=1024
# Required only by deploy.sh; use a non-root deployment account.
FERVID_DEPLOY_HOST=
FERVID_PUBLIC_URL=
