OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-lite-tts
OPENROUTER_TTS_VOICE=Kore
OPENROUTER_TTS_FORMAT=pcm
VIDEO_NARRATION_LANGUAGE=en-IN

# Server security configuration (production uses HTTPS).
FERVID_ADDR=127.0.0.1:8080
FERVID_SECURE_COOKIES=true
FERVID_ADMIN_PASSWORD=
FERVID_SESSION_KEY=
FERVID_TRUSTED_PROXIES=
FERVID_SMTP_ALLOWED_HOSTS=
FERVID_ATTACHMENT_QUOTA_MB=1024
# Required only by deploy.sh; use a non-root deployment account.
FERVID_DEPLOY_HOST=
FERVID_PUBLIC_URL=
